@model IEnumerable<SistemaEventosSonart.Models.ServicioAdicional>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreServicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioReferencial)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NombreServicio)
            </td>
            <td>
                @Html.DisplayFor(model => item.Categoria)
            </td>
            <td>
                @Html.DisplayFor(model => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(model => item.PrecioReferencial)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ServicioAdicionalId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ServicioAdicionalId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ServicioAdicionalId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
