@model IEnumerable<SistemaEventosSonart.Models.PaqueteServicio>

@{
    ViewData["Title"] = "Paquetes de Servicio";
}

<h1>Paquetes de Servicio</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Paquete</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre del Paquete</th>
            <th>Capacidad</th>
            <th>Descripción</th>
            <th>Precio Base</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombrePaquete</td>
                <td>@item.CapacidadPersonas personas</td>
                <td>@item.Descripcion</td>
                <td>$ @item.PrecioBase</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.PaqueteServicioId" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.PaqueteServicioId" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.PaqueteServicioId" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>