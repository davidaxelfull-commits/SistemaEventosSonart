@model IEnumerable<SistemaEventosSonart.Models.SolicitudEvento>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ClienteId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoEvento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaEvento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoSolicitud)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cotizaciones)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ClienteId)
            </td>
            <td>
                @Html.DisplayFor(model => item.TipoEvento)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaEvento)
            </td>
            <td>
                @Html.DisplayFor(model => item.EstadoSolicitud)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cliente)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cotizaciones)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SolicitudEventoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SolicitudEventoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SolicitudEventoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
